# =====================================================================
# FLZB Automation Suite - Environment Configuration Template
# =====================================================================
# Copy this file to `.env` and fill in your private credentials:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux/macOS)
# =====================================================================

# --- TempMail.lol Configuration ---
# API key for disposable inbox generation (optional, free tier works without key)
# Get a key at: https://tempmail.lol
TEMPMAIL_API_KEY=

# --- MoreLogin Local API Configuration ---
# Set these if running MoreLogin anti-detect browser; if left empty,
# the suite defaults to standard local Selenium Chrome sessions.
MORELOGIN_API_URL=http://127.0.0.1:40000
MORELOGIN_PROFILE_ID=

# --- Target Service Credentials ---
# Password/key for flzb.me login (used by flzb-me-login.py)
FLZB_PASSWORD=

# --- Default User Profile for Signup Bot (signup-bot.py) ---
# Fallback identity details if no input record or CLI flags are provided
USER_EMAIL=user@example.com
USER_FIRST_NAME=John
USER_LAST_NAME=Doe
DOB_MONTH=01
DOB_DAY=01
DOB_YEAR=1995
USER_SSN=000-00-0000
USER_ADDRESS=123 Main St
USER_ADDRESS_LINE2=
USER_CITY=Phoenix
USER_STATE=AZ
USER_ZIP=85001
USER_USERNAME=
USER_PASSWORD=StudentAid2026!#
